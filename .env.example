# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace_me

# MTProto application credentials from https://my.telegram.org/apps
API_ID=123456
API_HASH=replace_me

# Optional shared fallback destination. Per-user destinations are configured with /setstorage.
# Use a private numeric group/channel ID (for example -1001234567890).
# Add this bot to the destination and grant permission to post messages.
STORAGE_TARGET=

# Maximum supported media item size is 2 GiB. Ensure Railway temporary disk has enough free space.
# Optional temporary download directory (Railway ephemeral disk; default: system temp)
TEMP_DIR=/tmp/theogbot

# Optional MTProto worker tuning. Valid range: 1-32; default: 8.
# Benchmark on Railway before increasing either value.
THEOGBOT_DOWNLOAD_THREADS=8
THEOGBOT_UPLOAD_THREADS=8
